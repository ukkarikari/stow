#!/bin/sh

PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/xmonad-status-window.pid"
PANEL_LINES=16

# toggle if already running
if [ -s "$PIDFILE" ]; then
    pid=$(cat "$PIDFILE")

    if kill -0 "$pid" 2>/dev/null; then
        kill "$pid"
        rm -f "$PIDFILE"
        exit 0
    fi
fi

# feed PANEL_LINES slave lines each refresh
(
    while :; do
        battery=$(
            cat /sys/class/power_supply/BAT0/ 2>/dev/null ||
            cat /sys/class/power_supply/BAT0/capacity 2>/dev/null ||
            printf '?'
        )

        printf ' DEBUG UTILITIE   %s   BAT %s%%\n' \
            "$(date '+%a %Y-%m-%d  %H:%M:%S')" \
            "$battery"


        # Remaining PANEL_LINES lines = dzen slave window.
        {
            cat /tmp/xmonad-debug 2>/dev/null ||
                printf 'waiting for /tmp/xmonad-debug...\n'
        } |
            awk -v n="$PANEL_LINES" '
                NR <= n {
                    print
                    shown++
                }

                END {
                    while (shown < n) {
                        print ""
                        shown++
                    }
                }
            '

        sleep 1
    done
) |
    dzen2 \
        -l "$PANEL_LINES" \
        -u \
        -p \
        -x 760 \
        -y 0 \
        -w 600 \
        -h 14 \
        -ta l \
        -sa l \
        -fn 'Cozette:bold:size=10' \
        -bg '#000055' \
        -fg '#ffffff' \
        -e 'onstart=uncollapse;button3=exit' &

printf '%s\n' "$!" > "$PIDFILE"
